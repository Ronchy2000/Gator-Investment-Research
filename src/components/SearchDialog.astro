---
import { getCollection } from "astro:content";
import { articleHref, formatDate, plainText, sortArticles } from "../lib/articles";

const articles = sortArticles(await getCollection("articles"));
const searchIndex = articles.map((article) => ({
  title: article.data.title,
  description: article.data.description,
  date: formatDate(article.data.publishedAt),
  href: articleHref(article),
  text: plainText(article.body || ""),
}));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-shell">
    <div class="search-heading">
      <div>
        <span class="eyebrow">全文检索</span>
        <h2 id="search-title">查找信息</h2>
      </div>
      <button class="icon-button" type="button" data-search-close aria-label="关闭搜索">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <label class="search-field">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        type="search"
        data-search-input
        autocomplete="off"
        placeholder="输入标题、正文或日期"
        aria-label="搜索全部文章"
      />
      <kbd>ESC</kbd>
    </label>

    <p class="search-status" data-search-status>输入关键词，检索全部 {articles.length} 篇文章。</p>
    <ol class="search-results" data-search-results></ol>
  </div>
</dialog>

<script id="search-index" type="application/json" set:html={serializedIndex}></script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const results = document.querySelector<HTMLOListElement>("[data-search-results]");
  const indexElement = document.querySelector<HTMLScriptElement>("#search-index");
  const searchItems = indexElement ? JSON.parse(indexElement.textContent || "[]") : [];

  function normalize(value: string): string {
    return value.toLocaleLowerCase("zh-CN").replace(/\s+/g, " ").trim();
  }

  function openSearch(): void {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    window.setTimeout(() => input?.focus(), 30);
  }

  function closeSearch(): void {
    dialog?.close();
  }

  function renderResults(query: string): void {
    if (!results || !status) return;
    results.replaceChildren();
    const terms = normalize(query).split(" ").filter(Boolean);
    if (terms.length === 0) {
      status.textContent = `输入关键词，检索全部 ${searchItems.length} 篇文章。`;
      return;
    }

    const matches = searchItems
      .map((item: { title: string; description: string; date: string; href: string; text: string }) => {
        const title = normalize(item.title);
        const haystack = normalize(`${item.date} ${item.title} ${item.description} ${item.text}`);
        if (!terms.every((term) => haystack.includes(term))) return null;
        const score = terms.reduce((total, term) => {
          if (title.startsWith(term)) return total + 5;
          if (title.includes(term)) return total + 3;
          return total + 1;
        }, 0);
        return { item, score };
      })
      .filter(Boolean)
      .sort((left: any, right: any) => right.score - left.score)
      .slice(0, 20);

    status.textContent = matches.length
      ? `找到 ${matches.length} 条结果${matches.length === 20 ? "，仅显示前 20 条" : ""}。`
      : "没有找到匹配内容，请尝试更短的关键词。";

    for (const match of matches) {
      const item = match.item;
      const row = document.createElement("li");
      const link = document.createElement("a");
      const meta = document.createElement("span");
      const title = document.createElement("strong");
      const description = document.createElement("span");
      link.href = item.href;
      meta.className = "search-result-meta";
      meta.textContent = item.date;
      title.textContent = item.title;
      description.className = "search-result-description";
      description.textContent = item.description || "打开文章查看正文";
      link.append(meta, title, description);
      row.append(link);
      results.append(row);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-search-open]").forEach((button) => {
    button.addEventListener("click", openSearch);
  });
  document.querySelector<HTMLElement>("[data-search-close]")?.addEventListener("click", closeSearch);
  input?.addEventListener("input", () => renderResults(input.value));
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeSearch();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
    if (event.key === "/" && document.activeElement?.tagName !== "INPUT") {
      event.preventDefault();
      openSearch();
    }
  });
</script>
