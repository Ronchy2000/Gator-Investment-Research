---
import { getCollection } from "astro:content";
import { ARTICLE_SOURCES, articlesFromSource } from "../lib/articles";

const [articles, reports, notes] = await Promise.all([
  getCollection("articles"),
  getCollection("reports"),
  getCollection("notes"),
]);
const totalEntries = articles.length + reports.length + notes.length;
const sourceCounts = new Map(
  ARTICLE_SOURCES.map((source) => [source.slug, articlesFromSource(articles, source.name).length]),
);
---

<dialog
  class="search-dialog"
  data-search-dialog
  data-search-total={totalEntries}
  aria-labelledby="search-title"
>
  <div class="search-shell">
    <div class="search-heading">
      <div>
        <span class="eyebrow">全文检索</span>
        <h2 id="search-title">查找信息</h2>
      </div>
      <button class="icon-button" type="button" data-search-close aria-label="关闭搜索">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <label class="search-field">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        type="search"
        data-search-input
        autocomplete="off"
        placeholder="输入标题、正文或日期"
        aria-label="搜索全部内容"
      />
      <kbd>ESC</kbd>
    </label>

    <div class="search-filters" aria-label="搜索范围">
      <button type="button" data-search-scope="all" aria-pressed="true">全部 {totalEntries}</button>
      {ARTICLE_SOURCES.map((source) => (
        <button type="button" data-search-scope={`source:${source.slug}`} aria-pressed="false">
          {source.label} {sourceCounts.get(source.slug)}
        </button>
      ))}
      <button type="button" data-search-scope="report" aria-pressed="false">历史研报 {reports.length}</button>
      <button type="button" data-search-scope="note" aria-pressed="false">投资随笔 {notes.length}</button>
    </div>

    <p class="search-status" data-search-status>搜索索引将在首次使用时加载。</p>
    <ol class="search-results" data-search-results></ol>
  </div>
</dialog>

<script>
  interface SearchItem {
    title: string;
    description: string;
    date: string;
    href: string;
    text: string;
    kind: "wechat" | "report" | "note";
    source?: string;
    label: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const results = document.querySelector<HTMLOListElement>("[data-search-results]");
  const totalEntries = Number(dialog?.dataset.searchTotal || 0);
  let searchItems: SearchItem[] = [];
  let activeScope = "all";
  let loadPromise: Promise<void> | null = null;

  function normalize(value: string): string {
    return value.toLocaleLowerCase("zh-CN").replace(/\s+/g, " ").trim();
  }

  function matchesScope(item: SearchItem): boolean {
    if (activeScope === "all") return true;
    if (activeScope.startsWith("source:")) return item.source === activeScope.slice(7);
    return item.kind === activeScope;
  }

  async function loadSearchIndex(): Promise<void> {
    if (searchItems.length > 0) return;
    if (!loadPromise) {
      if (status) status.textContent = "正在加载全文索引…";
      loadPromise = fetch("/search-index.json")
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((items: SearchItem[]) => {
          searchItems = items;
          renderResults(input?.value || "");
        })
        .catch(() => {
          if (status) status.textContent = "搜索索引加载失败，请刷新页面后重试。";
          loadPromise = null;
        });
    }
    await loadPromise;
  }

  function openSearch(): void {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    void loadSearchIndex();
    window.setTimeout(() => input?.focus(), 30);
  }

  function closeSearch(): void {
    dialog?.close();
  }

  function renderResults(query: string): void {
    if (!results || !status || searchItems.length === 0) return;
    results.replaceChildren();
    const terms = normalize(query).split(" ").filter(Boolean);
    if (terms.length === 0) {
      const scopeCount = activeScope === "all"
        ? totalEntries
        : searchItems.filter(matchesScope).length;
      status.textContent = `输入关键词，检索当前范围内的 ${scopeCount} 条内容。`;
      return;
    }

    const matches = searchItems
      .filter(matchesScope)
      .map((item) => {
        const title = normalize(item.title);
        const haystack = normalize(`${item.date} ${item.label} ${item.title} ${item.description} ${item.text}`);
        if (!terms.every((term) => haystack.includes(term))) return null;
        const score = terms.reduce((total, term) => {
          if (title.startsWith(term)) return total + 5;
          if (title.includes(term)) return total + 3;
          return total + 1;
        }, 0);
        return { item, score };
      })
      .filter(Boolean)
      .sort((left: any, right: any) => right.score - left.score)
      .slice(0, 30);

    status.textContent = matches.length
      ? `找到 ${matches.length} 条结果${matches.length === 30 ? "，仅显示前 30 条" : ""}。`
      : "没有找到匹配内容，请尝试更短的关键词。";

    for (const match of matches) {
      const item = match.item;
      const row = document.createElement("li");
      const link = document.createElement("a");
      const meta = document.createElement("span");
      const title = document.createElement("strong");
      const description = document.createElement("span");
      link.href = item.href;
      meta.className = "search-result-meta";
      meta.textContent = `${item.date} · ${item.label}`;
      title.textContent = item.title;
      description.className = "search-result-description";
      description.textContent = item.description || "打开查看完整内容";
      link.append(meta, title, description);
      row.append(link);
      results.append(row);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-search-open]").forEach((button) => {
    button.addEventListener("click", openSearch);
  });
  document.querySelector<HTMLElement>("[data-search-close]")?.addEventListener("click", closeSearch);
  document.querySelectorAll<HTMLButtonElement>("[data-search-scope]").forEach((button) => {
    button.addEventListener("click", () => {
      activeScope = button.dataset.searchScope || "all";
      document.querySelectorAll<HTMLButtonElement>("[data-search-scope]").forEach((candidate) => {
        candidate.setAttribute("aria-pressed", String(candidate === button));
      });
      renderResults(input?.value || "");
    });
  });
  input?.addEventListener("input", () => renderResults(input.value));
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeSearch();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
    if (event.key === "/" && document.activeElement?.tagName !== "INPUT") {
      event.preventDefault();
      openSearch();
    }
  });
</script>
