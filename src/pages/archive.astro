---
import { getCollection } from "astro:content";
import ArticleRow from "../components/ArticleRow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatMonth, monthKey, sortArticles } from "../lib/articles";

const articles = sortArticles(await getCollection("articles"));
const groups = new Map<string, { label: string; articles: typeof articles }>();
for (const article of articles) {
  const key = monthKey(article.data.publishedAt);
  if (!groups.has(key)) {
    groups.set(key, { label: formatMonth(article.data.publishedAt), articles: [] });
  }
  groups.get(key)?.articles.push(article);
}
---

<BaseLayout title="公众号归档" description="按发布日期浏览获得信息差公众号的全部文章。">
  <header class="archive-hero page-width">
    <div>
      <span class="eyebrow">CHRONOLOGICAL ARCHIVE</span>
      <h1>公众号归档</h1>
    </div>
    <p>
      共 {articles.length} 篇内容。按公众号发布日期倒序排列，选择月份或使用全文搜索快速定位。
    </p>
  </header>

  <nav class="month-nav page-width" aria-label="月份导航">
    {[...groups.entries()].map(([key, group]) => (
      <a href={`#month-${key}`}>
        <span>{group.label}</span>
        <small>{group.articles.length}</small>
      </a>
    ))}
    <button type="button" data-search-open>搜索全部</button>
  </nav>

  <div class="archive-groups page-width">
    {[...groups.entries()].map(([key, group]) => (
      <section class="archive-group" id={`month-${key}`}>
        <header>
          <span>{key}</span>
          <h2>{group.label}</h2>
          <strong>{group.articles.length} 篇</strong>
        </header>
        <div>
          {group.articles.map((article, index) => (
            <ArticleRow article={article} number={index + 1} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-width {
    width: min(1220px, calc(100% - 40px));
    margin-inline: auto;
  }

  .archive-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 50px;
    align-items: end;
    padding-block: 100px 70px;
  }

  .archive-hero h1 {
    margin: 14px 0 0;
    font-family: var(--serif);
    font-size: clamp(65px, 10vw, 132px);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  .archive-hero p {
    max-width: 470px;
    margin: 0 0 12px auto;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 18px;
  }

  .month-nav {
    display: flex;
    flex-wrap: wrap;
    border-block: 1px solid var(--line-strong);
  }

  .month-nav a,
  .month-nav button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 49px;
    padding: 0 18px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    font-size: 12px;
  }

  .month-nav button {
    margin-left: auto;
    background: var(--ink);
    color: var(--paper);
  }

  .month-nav a:hover {
    background: var(--accent-soft);
  }

  .month-nav small {
    color: var(--ink-faint);
    font-family: var(--mono);
  }

  .archive-groups {
    padding-top: 90px;
  }

  .archive-group {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(35px, 6vw, 85px);
    padding: 30px 0 90px;
    scroll-margin-top: 100px;
  }

  .archive-group > header {
    position: sticky;
    top: 110px;
    align-self: start;
    padding-top: 4px;
  }

  .archive-group > header span,
  .archive-group > header strong {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
  }

  .archive-group > header h2 {
    margin: 10px 0 12px;
    font-family: var(--serif);
    font-size: 36px;
    font-weight: 500;
  }

  @media (max-width: 780px) {
    .archive-hero,
    .archive-group {
      grid-template-columns: 1fr;
    }

    .archive-hero {
      align-items: start;
      padding-block: 70px 50px;
    }

    .archive-hero p {
      margin-left: 0;
    }

    .archive-group {
      gap: 10px;
      padding-bottom: 65px;
    }

    .archive-group > header {
      position: static;
    }

    .month-nav button {
      margin-left: 0;
    }
  }
</style>
